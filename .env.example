# USERS anvands bara som bootstrap: vid forsta start seedas users-tabellen i
# databasen fran den har raden (forsta anvandaren blir admin). Darefter ar
# databasen kallan och nya anvandare laggs till via "Hantera anvandare" i UI:t.
USERS=hugo:replace-with-werkzeug-password-hash
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_SECURE=false
ENABLE_HSTS=false
PUBLIC_BASE_URL=https://trainyze.com

# Ägarens /ai-kontroll. Skapa båda hemligheterna med:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
AI_CONTROL_ENABLED=false
AI_RP_ID=trainyze.com
AI_ORIGIN=https://trainyze.com
AI_PASSKEY_BOOTSTRAP_TOKEN=
AI_AGENT_TOKEN=
AI_STEP_UP_TTL_SECONDS=600

DATABASE_URL=postgresql://dashboard:password@localhost/dashboard

# AI-coach: gemini (gratis nyckel pa aistudio.google.com) eller anthropic.
# LLM_PROVIDER kan utelamnas - da valjs gemini automatiskt om GEMINI_API_KEY finns.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=sk-ant-...
GARMIN_EMAIL=your-email@example.com
GARMIN_PASSWORD=your-garmin-password

# Strava OAuth. Create an API application at https://www.strava.com/settings/api
# and use the public Trainyze host as its callback domain.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=https://trainyze.com/strava/callback
# STRAVA_TOKEN_DIR=/var/lib/trainyze/strava

AC_LOOP_SERVICE=ac-keeper-loop
AC_BEDTIME_OVERRIDE=data/ac_bedtime_override.json
WATER_TOKEN=replace-with-a-long-random-token
AC_BUTTON_TOKEN=replace-with-a-long-random-token

WEATHER_LOCATION=Smogen
WEATHER_LAT=58.35593
WEATHER_LON=11.22411
